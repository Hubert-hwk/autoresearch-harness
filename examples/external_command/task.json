{
  "schema_version": "task.v2",
  "name": "external_command_ranking_v2",
  "objective": "Tune a real command-backed ranking rule while controlling false positives and runtime.",
  "executor": "external_command",
  "dataset": "dataset.jsonl",
  "budget": {
    "max_trials": 8,
    "max_wall_time_seconds": 30,
    "max_fidelity_units": 44
  },
  "search_space": {
    "threshold": {"type": "categorical", "values": [0.4, 0.55, 0.7]},
    "signal_weight": {"type": "categorical", "values": [0.8, 1.0]},
    "bias": {"type": "categorical", "values": [-0.05, 0.05]}
  },
  "metrics": {
    "primary": {"name": "accuracy", "direction": "maximize"},
    "guardrails": [
      {"name": "false_positive_rate", "max": 0.25},
      {"name": "evaluation_time_ms", "max": 1000}
    ]
  },
  "execution": {
    "command": ["{python}", "evaluate.py"],
    "working_directory": ".",
    "metrics_path": "metrics.json",
    "artifact_paths": ["details.json"],
    "timeout_seconds": 5,
    "environment": {"PYTHONHASHSEED": "0"}
  },
  "mutation": {
    "editable_paths": ["examples/external_command/evaluate.py"],
    "allow_create": false,
    "max_file_bytes": 100000
  },
  "scheduling": {
    "protocol_version": "scheduling.v1",
    "strategy": "successive_halving",
    "initial_candidates": 4,
    "reduction_factor": 2,
    "random_seed": 17,
    "fidelity": {
      "parameter": "case_count",
      "levels": [6, 10]
    },
    "objectives": [
      {"name": "accuracy", "direction": "maximize"},
      {"name": "false_positive_rate", "direction": "minimize"}
    ]
  },
  "verification": {
    "protocol_version": "verification.v1",
    "seed_parameter": "seed",
    "seeds": [11, 23, 37],
    "confidence_level": 0.95,
    "bootstrap_samples": 1000,
    "bootstrap_seed": 2026,
    "min_primary_improvement": 0.01,
    "min_guardrail_pass_rate": 1.0,
    "metric_tolerance": 1e-9,
    "replay_metrics": ["accuracy", "false_positive_rate", "evaluated_cases"],
    "fingerprint_paths": ["evaluate.py"]
  }
}
